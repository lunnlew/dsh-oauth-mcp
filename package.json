{
  "name": "dsh-oauth-mcp",
  "version": "0.0.1",
  "description": "OAuth 2.1 client and MCP bridge for DSH: discover and authorize remote MCP servers, keep tokens fresh, and expose their tools",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oauth",
    "oauth2",
    "mcp",
    "model-context-protocol",
    "pkce",
    "authorization",
    "remote-mcp",
    "mcp-client",
    "oauth授权"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh-CN.json": "./locale/zh-CN.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "client/index.js",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "react": "^18.2.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5",
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunnlew/dsh-oauth-mcp.git"
  },
  "homepage": "https://github.com/lunnlew/dsh-oauth-mcp#readme",
  "bugs": {
    "url": "https://github.com/lunnlew/dsh-oauth-mcp/issues"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "mock": "node scripts/mock-server.js",
    "repair:credentials": "node scripts/repair-credentials.mjs",
    "sync:client": "node scripts/sync-client.mjs",
    "build:locale": "node scripts/build-locale-json.mjs",
    "build:vendors": "node scripts/build-vendor-presets.mjs",
    "build": "node scripts/build-vendor-presets.mjs && node scripts/sync-client.mjs && node scripts/build-locale-json.mjs",
    "probe:vendors": "node scripts/probe-vendors.mjs",
    "check:vendors": "node scripts/check-vendors.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:redirects": "node scripts/check-redirect-uris.mjs"
  }
}
